{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {"api/index.js": {"maxDuration": 60}},
  "headers": [{
    "source": "/(.*)",
    "headers": [
      {"key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data: https://tile.openstreetmap.org; connect-src 'self' https://api.open-meteo.com https://routing.openstreetmap.de; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"},
      {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
      {"key": "X-Content-Type-Options", "value": "nosniff"},
      {"key": "X-Frame-Options", "value": "DENY"},
      {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()"}
    ]
  }],
  "rewrites": [
    {"source": "/api/:path*", "destination": "/api"},
    {"source": "/groundskeeper.html", "destination": "/index.html"},
    {"source": "/lawn.html", "destination": "/index.html"},
    {"source": "/dashboard.html", "destination": "/index.html"}
  ]
}
